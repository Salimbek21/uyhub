# UyHub configuration.
#
#   cp .env.example .env
#
# Every variable the full system will need is listed here, grouped by the phase
# that introduces it (docs/SPEC.md section 17). Variables for later phases are
# commented out; the application ignores unknown variables, so uncommenting one
# early is harmless but has no effect until that phase ships.
#
# NEVER commit a filled-in .env. Production .env lives only on the server, mode 0600.

# ===========================================================================
# Phase 0 — Foundation
# ===========================================================================

# local | test | staging | production
APP_ENV=local

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# json for deployments, console for a readable local terminal
LOG_FORMAT=console

# --- PostgreSQL ------------------------------------------------------------
# Credentials the postgres container is created with.
POSTGRES_USER=uyhub
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=uyhub
# Host ports use a 1xxxx offset instead of the stock 5432/6379/9000 so UyHub can
# run next to other local stacks without a port clash. Bound to localhost only;
# never exposed in production.
POSTGRES_HOST_PORT=15432

# Application connection string. Must use the asyncpg driver.
# Host is `localhost` when running the app on the host, `postgres` inside Compose.
DATABASE_URL=postgresql+asyncpg://uyhub:change-me-locally@localhost:15432/uyhub
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# --- Redis -----------------------------------------------------------------
REDIS_HOST_PORT=16379
REDIS_URL=redis://localhost:16379/0

# --- Object storage (SeaweedFS, S3 API) -------------------------------------
# There is one credential pair, used both to configure the server and to talk to
# it. SeaweedFS grants anonymous full access when it has no identity file, so
# S3_SECRET_KEY being set is what keeps the originals private.
S3_HOST_PORT=19000
S3_ENDPOINT_URL=http://localhost:19000
S3_ACCESS_KEY=uyhub
S3_SECRET_KEY=change-me-locally
S3_REGION=us-east-1
# Collector originals — private, never served to users.
S3_BUCKET_RAW=uyhub-raw
# Derived webp (large, thumb) — served read-only through Caddy.
S3_BUCKET_MEDIA=uyhub-media

# --- API --------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# --- Observability ----------------------------------------------------------
# Optional. See docs/OPEN_QUESTIONS.md A6 before enabling in production: Sentry is
# a foreign service and exception payloads can carry personal data.
# SENTRY_DSN=

# ===========================================================================
# Phase 1 — Collector (Telethon userbot)
# ===========================================================================
# From https://my.telegram.org. The pair identifies the app, not the account;
# logging in still needs the phone, the SMS code and the 2FA password, which a
# human types into `make login-userbot` and which are never stored here.
# Left commented on purpose: with no value the collector refuses to start and
# everything else runs normally, whereas a placeholder would have it try to
# connect to Telegram with nonsense credentials. Uncomment and fill in to collect.
# TG_API_ID=1234567
# A 32-character hex string. The placeholder is deliberately low-entropy words
# rather than realistic hex so the gitleaks hook stays armed on this file.
# TG_API_HASH=replace-with-your-32-char-hash

# Telethon session file. Lives in a Docker volume, file mode 0600. Never committed.
# Locally, point it somewhere writable, e.g. ./.sessions/uyhub.session
TG_SESSION_PATH=/data/sessions/uyhub.session

# Joins per account per day. The single most dangerous number in this file:
# raising it is how a userbot account gets banned (SPEC 4.2).
COLLECTOR_MAX_JOINS_PER_DAY=5
# How much history to pull in when a source is first joined.
COLLECTOR_BACKFILL_DAYS=7

# ===========================================================================
# Phase 2 — Parser
# ===========================================================================
# HMAC key for phone hashes. The parser refuses to hash without it, so the
# parser will not run until this is set.
#   openssl rand -hex 32
# Changing it orphans every suppressed_phones row and un-suppresses listings
# whose owners asked for removal (OPEN_QUESTIONS C8). Generate once, keep.
PHONE_HASH_KEY=replace-with-a-local-dev-key

# Bump whenever extraction rules change, so `uyhub reparse --version-below N`
# can find everything the older logic produced.
PARSER_VERSION=1

# Central Bank of Uzbekistan daily rates, used to express so'm prices in USD.
CBU_API_URL=https://cbu.uz/uz/arkhiv-kursov-valyut/json/

# The LLM extractor is not built yet; turning this on fails loudly rather than
# silently running the regex one and calling it an LLM (docs/DECISIONS.md P.4).
LLM_ENABLED=false
# Needed only to record fixtures and to run the eval in real mode; tests never
# call the real API.
# ANTHROPIC_API_KEY=
# Exact model id is chosen at implementation time and recorded in docs/DECISIONS.md.
# LLM_MODEL=
# LLM_MAX_CONCURRENCY=8
# LLM_DAILY_BUDGET_USD=10

# ===========================================================================
# Dedup and lifecycle
# ===========================================================================
# How far back a repost can match an existing listing (SPEC 7.1).
DEDUP_LOOKBACK_DAYS=60

# Text-similarity threshold, in bits of Hamming distance. SPEC suggests 6;
# measured on real posts a repost of the same flat lands at 9 while a different
# flat is 26, so 6 would never fire. See docs/DECISIONS.md 3.7.
DEDUP_SIMHASH_MAX_DISTANCE=12

# Photo-similarity threshold. Recompression and resizing cost 0 bits in
# practice, so this one is comfortable where SPEC put it.
DEDUP_PHASH_MAX_DISTANCE=6

# How far two prices may differ and still be the same flat.
DEDUP_PRICE_TOLERANCE_PCT=5

# How long a listing survives without being seen again (SPEC 8).
LISTING_TTL_DAYS_SALE=30
LISTING_TTL_DAYS_RENT=14

# ===========================================================================
# Phase 4 — API
# ===========================================================================
# PHONE_HASH_KEY is in the parser section above — the parser needs it first.

# Exact origins allowed to call the API, comma-separated. Empty means no
# browser origin is allowed — a missing value must not open the API to
# everyone. In production this is the Mini App's origin and nothing else.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Where a browser reaches the public media bucket. Derivatives only; the
# originals bucket is private and is never addressed through this.
MEDIA_PUBLIC_BASE_URL=http://localhost:19000/uyhub-media

API_RATE_LIMIT_PER_MINUTE=120
API_RATE_LIMIT_BURST=40

# Accept requests with no Telegram initData and treat them as a test user, so
# the feed can be opened in a plain browser before a BOT_TOKEN exists. This
# turns off the only check that proves a caller came from Telegram; startup
# refuses it outright when APP_ENV=production (docs/DECISIONS.md 4.5).
API_ALLOW_INSECURE_AUTH=false

# Needed to verify initData signatures. The bot itself is a later phase, but
# the token is what makes authentication real — see the Phase 6 section.
# BOT_TOKEN=

# No CONTACT_REVEAL_LIMIT: phone numbers are never served, so there is no
# reveal endpoint to rate-limit (docs/DECISIONS.md P.2).

# ===========================================================================
# Phase 6 — Bot and channel poster
# ===========================================================================
# Separate bots for staging and production.
# BOT_TOKEN=
# ADMIN_USER_IDS=
# CHANNEL_ID=
# POSTER_MIN_QUALITY=60
# POSTER_INTERVAL_SECONDS=20
# POSTER_SHOW_PHONE=false
# NOTIFY_MAX_PER_HOUR=10

# ===========================================================================
# Phase 7 — Operations
# ===========================================================================
# Generate on the server: openssl rand -base64 48
# BACKUP_PASSPHRASE=
# BACKUP_RETENTION_DAILY=14
# BACKUP_RETENTION_WEEKLY=8

# ===========================================================================
# Phase 8 — Deployment
# ===========================================================================
# DOMAIN=example.uz
# ACME_EMAIL=ops@example.uz
